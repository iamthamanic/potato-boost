{
  "name": "potato-boost",
  "private": true,
  "version": "0.0.0",
  "description": "Local CLI and dashboard for reproducible performance findings",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "potato-boost": "./packages/cli/dist/bin.js",
    "potato": "./packages/cli/dist/bin.js"
  },
  "scripts": {
    "dev": "echo 'apps/dashboard is not scaffolded yet — see AGENTS.md'",
    "build": "tsc -b",
    "lint": "biome check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:contract": "echo 'Add adapter contract tests after packages/adapter-sdk'",
    "test:security": "echo 'Add security tests after local-api'",
    "test:performance": "echo 'Add fixture benchmarks after fixtures/web-threejs'",
    "test:e2e": "playwright test",
    "checks": "bash scripts/run-checks.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
