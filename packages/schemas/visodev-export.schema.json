{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Potato Boost VisoDev Export",
  "type": "object",
  "required": ["schemaVersion", "runId", "findings", "evidence"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId", "ruleId", "severity", "confidence"],
        "properties": {
          "findingId": { "type": "string" },
          "ruleId": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error"] },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "confidence"],
        "properties": {
          "evidenceId": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}
