{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rawHash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["kind", "id", "rawHash"],
        "additionalProperties": {}
      }
    },
    "calculation": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  },
  "required": ["evidenceId", "inputs", "calculation", "confidence"],
  "additionalProperties": {}
}
